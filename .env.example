# Copy to .env and fill locally. NEVER commit .env.

# Neo4j AuraDB
NEO4J_URI=
NEO4J_USER=neo4j
# The notebook also accepts NEO4J_USERNAME from Aura credential exports.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Groq extraction/generation
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# LLM-as-a-Judge
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

# Hugging Face
HF_TOKEN=

# Runtime switches
ENABLE_NEAR_DEDUP=0
RESET_LAB_GRAPH=0
FORCE_DATA_DOWNLOAD=0
RESUME_EVAL=1
